<group name="cowrie,honeypot,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>Cowrie honeypot event</description>
  </rule>

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.connect$</field>
    <description>Cowrie: anslutning till honeypot fran $(src_ip)</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Cowrie: misslyckad login $(username)/$(password) fran $(src_ip)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Cowrie: LYCKAD login $(username)/$(password) fran $(src_ip)</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100104" level="8">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.command\.input$</field>
    <description>Cowrie: kommando i honeypot: $(input) fran $(src_ip)</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <rule id="100105" level="12">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.file_download$</field>
    <description>Cowrie: fil/malware nedladdad i honeypot fran $(src_ip)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>
